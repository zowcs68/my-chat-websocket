{
  "name": "chat-tui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A production-grade terminal chat client built with Bun, TypeScript, OpenTUI/Solid, and native WebSockets.",
  "scripts": {
    "dev": "bun run src/client/index.tsx",
    "start": "bun run src/client/index.tsx",
    "server": "bun run src/server/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
